{
  "name": "agent-space",
  "version": "0.1.0",
  "private": true,
  "description": "Agent 空间：人、个人 agent、空间助理和专项 agent 在同一个空间里把事做完。基于 DeepSeek Harness (dsh)。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sdk-client": "0.2.2-rc.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.2.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fastify": "^5.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
