# 必填：任意 OpenAI 兼容服务的 API key。所有 agent 共用这一把 key。
MODEL_API_KEY=

# 必填：该服务的 OpenAI 兼容 base URL，停在版本前缀，一般以 /v1 结尾。
# 例：https://api.openai.com/v1
#     https://api.deepseek.com/v1
#     https://api.moonshot.cn/v1
MODEL_BASE_URL=

# 必填：模型名，以服务商文档为准。例：gpt-4.1、deepseek-chat、kimi-k2
MODEL_NAME=

# 生产环境必改：登录 cookie 的签名密钥
COOKIE_SECRET=

# 可选：登录时需要输入的访问码，留空表示任何邮箱都能登录
ACCESS_CODE=

# 可选
# PORT=8787
# DATA_DIR=./data
# MAX_CONCURRENT_AGENTS=4
# AGENT_TIMEOUT_MS=480000

# 旧变量仍可用，新部署不要填：
# DEEPSEEK_API_KEY=
# DSH_MODEL=
# DSH_PROVIDER=
# 自定义地址按 OpenAI 兼容接口连接。只有走 harness 内置目录、且不填 MODEL_BASE_URL 时才需要：
# MODEL_PROVIDER=
