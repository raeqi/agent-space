# 留空则进入演示模式（脚本回复，不用 key）。要接真实模型时再填。所有 agent 共用这一把 key。
MODEL_API_KEY=

# 真实模型时填写：OpenAI 兼容 base URL，停在版本前缀，一般以 /v1 结尾。
# 例：https://api.openai.com/v1
#     https://api.deepseek.com
#     https://api.moonshot.cn/v1
MODEL_BASE_URL=

# 真实模型时填写：模型名，以服务商文档为准。例：gpt-4.1、deepseek-v4-pro、kimi-k2
# DeepSeek 也可以用 deepseek-flash，更快、更便宜。deepseek-chat 是旧别名，会落到 flash。
MODEL_NAME=

# 演示模式可留空，程序会生成并记住。给别人用时必改：登录 cookie 的签名密钥
COOKIE_SECRET=

# 可选：设为 1 时，即使填了 MODEL_API_KEY 也使用演示模式
# DEMO_MODE=1

# 可选：登录时需要输入的访问码，留空表示任何邮箱都能登录
ACCESS_CODE=

# 可选
# PORT=8787
# DATA_DIR=./data
# MAX_CONCURRENT_AGENTS=4
# AGENT_TIMEOUT_MS=480000

# 旧变量仍可用，新部署不要填：
# DEEPSEEK_API_KEY=
# DSH_MODEL=
# DSH_PROVIDER=
# 自定义地址按 OpenAI 兼容接口连接。只有走 harness 内置目录、且不填 MODEL_BASE_URL 时才需要：
# MODEL_PROVIDER=
